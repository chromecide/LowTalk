$LegendCommon = "../ToolsLegends/ToolsLegendsCommon.ui";

// The LowTalk tool's legend, shown while the tool is held, built from the same macros as the game's own tool legends.
$LegendCommon.@Legend {
  #Pages {
    $LegendCommon.@Page #Page1 {
      @Title = %server.lowtalk.tool.legend.title;

      $LegendCommon.@RowLabel {
        Text: %server.lowtalk.tool.legend.description;
      }

      $LegendCommon.@Separator {}

      $LegendCommon.@RowLabel {
        Text: %server.lowtalk.tool.legend.npcs;
      }

      $LegendCommon.@HotkeyRow {
        @InputBindingKey = "PrimaryItemAction";
        @Description = %server.lowtalk.tool.legend.npcEdit;
      }

      $LegendCommon.@HotkeyRow {
        @InputBindingKey = "SecondaryItemAction";
        @Description = %server.lowtalk.tool.legend.npcPlay;
      }

      $LegendCommon.@Separator {}

      $LegendCommon.@RowLabel {
        Text: %server.lowtalk.tool.legend.blocks;
      }

      $LegendCommon.@HotkeyRow {
        @InputBindingKey = "PrimaryItemAction";
        @Description = %server.lowtalk.tool.legend.blockBind;
      }

      $LegendCommon.@HotkeyRow {
        @InputBindingKey = "SecondaryItemAction";
        @Description = %server.lowtalk.tool.legend.blockPlay;
      }

      $LegendCommon.@Separator {}

      $LegendCommon.@RowLabel {
        Text: %server.lowtalk.tool.legend.hint;
      }
    }
  }
}
