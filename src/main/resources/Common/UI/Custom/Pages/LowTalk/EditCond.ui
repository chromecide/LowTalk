$C = "../../Common.ui";

// A condition, as a thing, a comparison and a value: "the player has | Food_Bread | yes", "the objective |
// Find_The_Elder | is | complete". The same three controls a command's arguments use, so an id is a list or a
// picker and a fixed set of words is a list.
//
// A condition that is none of those shapes, anything with and, or, brackets or arithmetic, is shown in #Raw as
// plain text instead, which is what it always was.
Group {
  LayoutMode: Left;
  Anchor: (Height: 38, Bottom: 6);

  Label #Pad {
    Anchor: (Width: 26);
  }

  Label #Tag {
    Anchor: (Width: 90);
    Style: (FontSize: 12, TextColor: #96a9be, RenderUppercase: true, VerticalAlignment: Center);
    Text: "";
  }

  DropdownBox #Kind {
    Anchor: (Width: 260, Right: 8, Height: $C.@DropdownBoxHeight);
    Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 360);
    ShowSearchInput: true;
  }

  Group #Arg {
    FlexWeight: 3;
    LayoutMode: Left;

    $C.@TextField #V {
      @Anchor = (Right: 8);
      FlexWeight: 1;
    }

    DropdownBox #C {
      Anchor: (Right: 8, Height: $C.@DropdownBoxHeight);
      FlexWeight: 1;
      Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 300);
      ShowSearchInput: true;
    }

    $C.@SecondaryTextButton #B {
      @Anchor = (Left: 0, Right: 8);
      @Text = "";
      FlexWeight: 1;
    }
  }

  DropdownBox #Op {
    Anchor: (Width: 150, Right: 8, Height: $C.@DropdownBoxHeight);
    Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 220);
  }

  Group #Val {
    FlexWeight: 3;
    LayoutMode: Left;

    $C.@TextField #VV {
      @Anchor = (Right: 8);
      FlexWeight: 1;
    }

    DropdownBox #VC {
      Anchor: (Right: 8, Height: $C.@DropdownBoxHeight);
      FlexWeight: 1;
      Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 300);
      ShowSearchInput: true;
    }

    $C.@SecondaryTextButton #VB {
      @Anchor = (Left: 0, Right: 8);
      @Text = "";
      FlexWeight: 1;
    }
  }

  $C.@TextField #Raw {
    @Anchor = (Right: 8);
    FlexWeight: 6;
    PlaceholderText: %server.lowtalk.editor.conditionHint;
  }
}
