$C = "../../Common.ui";

// The LowTalk tool on a block: which dialogue it opens and whether the block's own action still runs.
$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 640, Height: 330);

    #Title {
      $C.@Title #PageTitle {
        @Text = %server.lowtalk.bindblock.title;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Where {
        Anchor: (Bottom: 12);
        Style: (FontSize: 14, TextColor: #96a9be);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 8);

        Label {
          Anchor: (Width: 130);
          Style: (FontSize: 12, TextColor: #96a9be, RenderUppercase: true, VerticalAlignment: Center);
          Text: %server.lowtalk.bindblock.dialogue;
        }

        DropdownBox #Dialogue {
          Anchor: (Width: 460, Height: $C.@DropdownBoxHeight);
          Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 460);
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 8);

        Label {
          Anchor: (Width: 130);
          Style: (FontSize: 12, TextColor: #96a9be, RenderUppercase: true, VerticalAlignment: Center);
          Text: %server.lowtalk.bindblock.mode;
        }

        DropdownBox #Mode {
          Anchor: (Width: 460, Height: $C.@DropdownBoxHeight);
          Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 460);
        }
      }

      Label #Help {
        Anchor: (Top: 4);
        Style: (FontSize: 12, TextColor: #8fa3b8, Wrap: true);
        Text: %server.lowtalk.bindblock.help;
      }

      Group {
        LayoutMode: Right;
        Anchor: (Top: 14, Height: 34);

        $C.@TextButton #BindButton {
          @Anchor = (Width: 140, Right: 8);
          @Text = %server.lowtalk.bindblock.bind;
        }

        $C.@SecondaryTextButton #UnbindButton {
          @Anchor = (Width: 140, Right: 8);
          @Text = %server.lowtalk.bindblock.unbind;
        }

        $C.@SecondaryTextButton #CancelButton {
          @Anchor = (Width: 120);
          @Text = %server.lowtalk.editor.close;
        }
      }
    }
  }
}
