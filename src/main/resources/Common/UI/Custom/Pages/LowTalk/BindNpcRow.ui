$C = "../../Common.ui";

// One dialogue bound to the NPC: id, why it applies, Edit and Unbind.
Group {
  LayoutMode: Left;
  Anchor: (Height: 34, Bottom: 4);

  Label #Id {
    Anchor: (Width: 240, Right: 8);
    Style: (FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center);
  }

  Label #How {
    FlexWeight: 1;
    Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
  }

  $C.@SecondaryTextButton #UnbindButton {
    @Anchor = (Width: 90, Right: 6);
    @Text = %server.lowtalk.bindblock.unbind;
  }

  $C.@TextButton #EditButton {
    @Anchor = (Width: 90);
    @Text = %server.lowtalk.browse.edit;
  }
}
