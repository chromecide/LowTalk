$C = "../../Common.ui";
$Sounds = "../../Sounds.ui";

// Options look like the game's own choice lists: plain text that lights up on hover.
@OptionStyle = (
  Default: (
    LabelStyle: (FontSize: 16, TextColor: #d6e2f0, HorizontalAlignment: Left, VerticalAlignment: Center)
  ),
  Hovered: (
    LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Left, VerticalAlignment: Center),
    Background: #ffffff(0.08)
  ),
  Pressed: (
    LabelStyle: (FontSize: 16, TextColor: #ffd37a, RenderBold: true, HorizontalAlignment: Left, VerticalAlignment: Center),
    Background: #ffffff(0.12)
  ),
  Sounds: $Sounds.@ButtonsLight
);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 680, Height: 520);

    #Title {
      $C.@Title #NpcTitle {
        @Text = "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Group #Top {
        LayoutMode: Left;
        FlexWeight: 1;

        Group #PortraitBox {
          Anchor: (Width: 96, Right: 14);
          Visible: false;

          Group #Portrait {
            Anchor: (Width: 96, Height: 96, Top: 4);
          }
        }

        Group {
          LayoutMode: Top;
          FlexWeight: 1;

          Label #Speaker {
            Anchor: (Bottom: 6);
            Style: (FontSize: 14, RenderBold: true, RenderUppercase: true, TextColor: #ffd37a);
          }

          Group #TextBox {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Padding: (Right: 8);

            Label #Text {
              Style: (...$C.@DefaultLabelStyle, FontSize: 17, TextColor: #e8eef6, Wrap: true);
            }
          }
        }
      }

      Label #Narration {
        Anchor: (Top: 6);
        Style: (FontSize: 13, TextColor: #8fa3b8, Wrap: true, HorizontalAlignment: Center);
      }

      Group #Options {
        LayoutMode: Top;
        Anchor: (Top: 10);
        Padding: (Left: 4);

        TextButton #Opt0 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt1 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt2 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt3 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt4 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt5 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt6 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt7 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }
      }

      Group #InputRow {
        LayoutMode: Left;
        Anchor: (Top: 8);
        Visible: false;

        $C.@TextField #Input {
          @Anchor = (Right: 8);
          FlexWeight: 1;
        }

        $C.@TextButton #OkButton {
          @Anchor = (Width: 100);
          @Text = "OK";
        }
      }

      Group #ContinueRow {
        LayoutMode: Center;
        Anchor: (Top: 8);
        Visible: false;

        $C.@TextButton #ContinueButton {
          @Anchor = (Width: 200);
          @Text = "Continue";
        }
      }

      Group #CloseRow {
        LayoutMode: Center;
        Anchor: (Top: 8);

        $C.@SecondaryTextButton #CloseButton {
          @Anchor = (Width: 140);
          @Text = "Leave";
        }
      }
    }
  }
}
