$C = "../../Common.ui";
$Sounds = "../../Sounds.ui";

// Options look like the game's own choice lists: plain text that lights up on hover.
@OptionStyle = (
  Default: (
    LabelStyle: (FontSize: 16, TextColor: #d6e2f0, HorizontalAlignment: Start, VerticalAlignment: Center)
  ),
  Hovered: (
    LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center),
    Background: #ffffff(0.08)
  ),
  Pressed: (
    LabelStyle: (FontSize: 16, TextColor: #ffd37a, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center),
    Background: #ffffff(0.12)
  ),
  Sounds: $Sounds.@ButtonsLight
);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 680, Height: 520);

    #Title {
      $C.@Title #NpcTitle {
        @Text = "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Group #Top {
        LayoutMode: Left;
        FlexWeight: 1;

        Group #PortraitBox {
          Anchor: (Width: 96, Right: 14);
          Visible: false;

          Group #Portrait {
            Anchor: (Width: 96, Height: 96, Top: 4);
          }
        }

        Group #Transcript {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Right: 8);
        }
      }

      Group #Options {
        LayoutMode: Top;
        Anchor: (Top: 10);
        Padding: (Left: 4);

        TextButton #Opt0 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt1 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt2 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt3 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt4 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt5 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt6 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }

        TextButton #Opt7 {
          Anchor: (Bottom: 4, Height: 36);
          Padding: (Horizontal: 12);
          Style: @OptionStyle;
          Visible: false;
        }
      }

      Group #InputRow {
        LayoutMode: Left;
        Anchor: (Top: 8);
        Visible: false;

        $C.@TextField #Input {
          @Anchor = (Right: 8);
          FlexWeight: 1;
        }

        $C.@TextButton #OkButton {
          @Anchor = (Width: 100);
          @Text = %server.lowtalk.ui.ok;
        }
      }

      Group #ContinueRow {
        LayoutMode: Center;
        Anchor: (Top: 8);
        Visible: false;

        $C.@TextButton #ContinueButton {
          @Anchor = (Width: 200);
          @Text = %server.lowtalk.ui.continue;
        }
      }

      Group #CloseRow {
        LayoutMode: Center;
        Anchor: (Top: 8);

        $C.@SecondaryTextButton #CloseButton {
          @Anchor = (Width: 140);
          @Text = %server.lowtalk.ui.leave;
        }
      }
    }
  }
}
