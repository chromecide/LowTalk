$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 640, Height: 500);

    #Title {
      $C.@Title #NpcTitle {
        @Text = "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Speaker {
        Anchor: (Bottom: 6);
        Style: (FontSize: 14, RenderBold: true, TextColor: #ffd37a);
      }

      Group #TextBox {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 8);

        Label #Text {
          Style: (...$C.@DefaultLabelStyle, FontSize: 17, Wrap: true);
        }
      }

      Label #Narration {
        Anchor: (Top: 6);
        Style: (FontSize: 13, TextColor: #8fa3b8, Wrap: true, HorizontalAlignment: Center);
      }

      Group #Options {
        LayoutMode: Top;
        Anchor: (Top: 10);

        $C.@TextButton #Opt0 {
          @Anchor = (Bottom: 6);
          @Text = "";
          Visible: false;
        }

        $C.@TextButton #Opt1 {
          @Anchor = (Bottom: 6);
          @Text = "";
          Visible: false;
        }

        $C.@TextButton #Opt2 {
          @Anchor = (Bottom: 6);
          @Text = "";
          Visible: false;
        }

        $C.@TextButton #Opt3 {
          @Anchor = (Bottom: 6);
          @Text = "";
          Visible: false;
        }

        $C.@TextButton #Opt4 {
          @Anchor = (Bottom: 6);
          @Text = "";
          Visible: false;
        }

        $C.@TextButton #Opt5 {
          @Anchor = (Bottom: 6);
          @Text = "";
          Visible: false;
        }

        $C.@TextButton #Opt6 {
          @Anchor = (Bottom: 6);
          @Text = "";
          Visible: false;
        }

        $C.@TextButton #Opt7 {
          @Anchor = (Bottom: 6);
          @Text = "";
          Visible: false;
        }
      }

      Group #InputRow {
        LayoutMode: Left;
        Anchor: (Top: 8);
        Visible: false;

        $C.@TextField #Input {
          @Anchor = (Right: 8);
          FlexWeight: 1;
        }

        $C.@TextButton #OkButton {
          @Anchor = (Width: 100);
          @Text = "OK";
        }
      }

      Group #ContinueRow {
        LayoutMode: Center;
        Anchor: (Top: 8);
        Visible: false;

        $C.@TextButton #ContinueButton {
          @Anchor = (Width: 200);
          @Text = "Continue";
        }
      }

      Group #CloseRow {
        LayoutMode: Center;
        Anchor: (Top: 8);

        $C.@SecondaryTextButton #CloseButton {
          @Anchor = (Width: 140);
          @Text = "Leave";
        }
      }
    }
  }
}
