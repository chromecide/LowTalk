$C = "../../Common.ui";

// A command. Which one, then one named field per argument it takes: "item" and "count" for give, "particle",
// "scale" and "seconds" for vfx. A command the editor has no argument names for (one another mod added, or one
// whose arguments do not fit) falls back to #Args, the single box of text this row used to be.
//
// Every slot carries a text field, a dropdown and a button; the editor shows whichever suits the argument and
// hides the rest, so one template covers free text, numbers, fixed choices and ids. A list short enough to hand
// over is a dropdown that searches itself; a list of thousands is a button that opens the picker page, because a
// dropdown is only filled once and could never search the rest.
Group {
  LayoutMode: Left;
  Anchor: (Height: 38, Bottom: 6);

  // A "!" here means the validator found an error on this row, a "?" a warning; empty when the row is fine.
  Label #Bad {
    Anchor: (Width: 16);
    Style: (FontSize: 15, TextColor: #ff9d8a, VerticalAlignment: Center, HorizontalAlignment: Center);
    Text: "";
  }

  Label #Tag {
    Anchor: (Width: 26);
    Style: (FontSize: 13, TextColor: #8fd0ff, VerticalAlignment: Center, HorizontalAlignment: Center);
    Text: "<<";
  }

  // The command's own name, shown and not editable. Every command has its own entry in the Add menu, so changing
  // one line into another is deleting the row and adding what you wanted; a second list of all the commands here
  // only offered a worse way to do the same thing.
  Label #Name {
    Anchor: (Width: 120, Right: 8);
    Style: (FontSize: 14, TextColor: #8fd0ff, RenderBold: true, VerticalAlignment: Center);
    Text: "";
  }

  Group #Arg0 {
    FlexWeight: 3;
    LayoutMode: Left;

    Label #L0 {
      Anchor: (Width: 56);
      Style: (FontSize: 12, TextColor: #8fa3b8, VerticalAlignment: Center);
      Text: "";
    }

    $C.@TextField #V0 {
      @Anchor = (Right: 8);
      FlexWeight: 1;
    }

    DropdownBox #C0 {
      // Width rather than FlexWeight: as the only visible control in its slot this stretched to the whole row,
      // and a dropdown far wider than its own PanelWidth never opens its panel at all.
      //
      // 300 was too wide for a slot that has to share the row with three others. On a four-argument command
      // it overran into the next slot and the next slot's label was drawn on top of it -- "seconds" over the
      // style box on <<title>>, and the "at" box under the row buttons on <<vfx>>. The panel stays wider than
      // the control, which is the rule that matters for it opening at all.
      Anchor: (Width: 200, Right: 8, Height: $C.@DropdownBoxHeight);
      Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 320);
      ShowSearchInput: true;
    }

    $C.@SecondaryTextButton #B0 {
      @Anchor = (Left: 0, Right: 8);
      @Text = "";
      FlexWeight: 1;
    }
  }

  Group #Arg1 {
    FlexWeight: 2;
    LayoutMode: Left;

    Label #L1 {
      Anchor: (Width: 56);
      Style: (FontSize: 12, TextColor: #8fa3b8, VerticalAlignment: Center);
      Text: "";
    }

    $C.@TextField #V1 {
      @Anchor = (Right: 8);
      FlexWeight: 1;
    }

    DropdownBox #C1 {
      Anchor: (Width: 200, Right: 8, Height: $C.@DropdownBoxHeight);
      Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 320);
      ShowSearchInput: true;
    }

    $C.@SecondaryTextButton #B1 {
      @Anchor = (Left: 0, Right: 8);
      @Text = "";
      FlexWeight: 1;
    }
  }

  Group #Arg2 {
    FlexWeight: 2;
    LayoutMode: Left;

    Label #L2 {
      Anchor: (Width: 56);
      Style: (FontSize: 12, TextColor: #8fa3b8, VerticalAlignment: Center);
      Text: "";
    }

    $C.@TextField #V2 {
      @Anchor = (Right: 8);
      FlexWeight: 1;
    }

    DropdownBox #C2 {
      Anchor: (Width: 200, Right: 8, Height: $C.@DropdownBoxHeight);
      Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 320);
      ShowSearchInput: true;
    }

    $C.@SecondaryTextButton #B2 {
      @Anchor = (Left: 0, Right: 8);
      @Text = "";
      FlexWeight: 1;
    }
  }

  Group #Arg3 {
    FlexWeight: 2;
    LayoutMode: Left;

    Label #L3 {
      Anchor: (Width: 56);
      Style: (FontSize: 12, TextColor: #8fa3b8, VerticalAlignment: Center);
      Text: "";
    }

    $C.@TextField #V3 {
      @Anchor = (Right: 8);
      FlexWeight: 1;
    }

    DropdownBox #C3 {
      Anchor: (Width: 200, Right: 8, Height: $C.@DropdownBoxHeight);
      Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 320);
      ShowSearchInput: true;
    }

    $C.@SecondaryTextButton #B3 {
      @Anchor = (Left: 0, Right: 8);
      @Text = "";
      FlexWeight: 1;
    }
  }

  $C.@TextField #Args {
    @Anchor = (Right: 8);
    FlexWeight: 3;
    PlaceholderText: %server.lowtalk.editor.args;
  }

  DropdownBox #Pick {
    Anchor: (Width: 210, Right: 8, Height: $C.@DropdownBoxHeight);
    Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 360);
    ShowSearchInput: true;
  }

  // A command that takes no arguments has nothing flexible in its row, so the buttons packed up against the
  // name instead of sitting at the right with every other row's. This fills the gap, and only then: when a
  // row has fields of its own they take the space and this is hidden.
  Label #Spacer {
    FlexWeight: 1;
    Text: "";
  }

  $C.@SecondaryTextButton #Up {
    @Anchor = (Width: 34, Right: 4);
    @Text = "^";
  }

  $C.@SecondaryTextButton #Down {
    @Anchor = (Width: 34, Right: 4);
    @Text = "v";
  }

  $C.@SecondaryTextButton #Del {
    @Anchor = (Width: 34);
    @Text = "x";
  }
}
