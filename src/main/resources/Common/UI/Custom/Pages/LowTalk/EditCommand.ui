$C = "../../Common.ui";

// A command: which one, its arguments as text, and a picker for the first argument when the game has a list for it.
Group {
  LayoutMode: Left;
  Anchor: (Height: 38, Bottom: 6);

  Label #Tag {
    Anchor: (Width: 26);
    Style: (FontSize: 13, TextColor: #8fd0ff, VerticalAlignment: Center, HorizontalAlignment: Center);
    Text: "<<";
  }

  DropdownBox #Name {
    Anchor: (Width: 170, Right: 6, Height: $C.@DropdownBoxHeight);
    Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 420, EntryTooltipStyle: $C.@DefaultTextTooltipStyle);
  }

  $C.@TextField #Args {
    @Anchor = (Right: 6);
    FlexWeight: 1;
    PlaceholderText: %server.lowtalk.editor.args;
  }

  DropdownBox #Pick {
    Anchor: (Width: 240, Right: 8, Height: $C.@DropdownBoxHeight);
    Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 320);
  }

  $C.@SecondaryTextButton #Up {
    @Anchor = (Width: 34, Right: 4);
    @Text = "^";
  }

  $C.@SecondaryTextButton #Down {
    @Anchor = (Width: 34, Right: 4);
    @Text = "v";
  }

  $C.@SecondaryTextButton #Del {
    @Anchor = (Width: 34);
    @Text = "x";
  }
}
