$C = "../../Common.ui";

// One player option: its label, where it leads, Go walks into that passage, Conditions opens its guards.
Group {
  LayoutMode: Left;
  Anchor: (Height: 38, Bottom: 6);

  Label #Arrow {
    Anchor: (Width: 26);
    Style: (FontSize: 16, TextColor: #ffd37a, VerticalAlignment: Center, HorizontalAlignment: Center);
    Text: "->";
  }

  $C.@TextField #Label {
    @Anchor = (Right: 6);
    FlexWeight: 1;
    PlaceholderText: %server.lowtalk.editor.optionText;
  }

  DropdownBox #Target {
    Anchor: (Width: 240, Right: 6, Height: $C.@DropdownBoxHeight);
    Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 300);
  }

  $C.@SecondaryTextButton #Go {
    @Anchor = (Width: 60, Right: 4);
    @Text = %server.lowtalk.editor.go;
  }

  $C.@SecondaryTextButton #More {
    @Anchor = (Width: 120, Right: 8);
    @Text = %server.lowtalk.editor.conditions;
  }

  $C.@SecondaryTextButton #Up {
    @Anchor = (Width: 64, Right: 4);
    @Text = %server.lowtalk.editor.up;
  }

  $C.@SecondaryTextButton #Down {
    @Anchor = (Width: 80, Right: 4);
    @Text = %server.lowtalk.editor.down;
  }

  $C.@SecondaryTextButton #Del {
    @Anchor = (Width: 90);
    @Text = %server.lowtalk.editor.delete;
  }
}
