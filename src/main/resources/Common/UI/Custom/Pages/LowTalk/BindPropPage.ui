$C = "../../Common.ui";

// The LowTalk tool on a prop: which dialogue it opens and, optionally, the name it speaks as.
$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 640, Height: 386);

    #Title {
      $C.@Title #PageTitle {
        @Text = %server.lowtalk.bindprop.title;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Where {
        Anchor: (Bottom: 12);
        Style: (FontSize: 14, TextColor: #96a9be);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 8);

        Label {
          Anchor: (Width: 130);
          Style: (FontSize: 12, TextColor: #96a9be, RenderUppercase: true, VerticalAlignment: Center);
          Text: %server.lowtalk.bindprop.dialogue;
        }

        DropdownBox #Dialogue {
          Anchor: (Width: 460, Height: $C.@DropdownBoxHeight);
          Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 460);
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 8);

        Label {
          Anchor: (Width: 130);
          Style: (FontSize: 12, TextColor: #96a9be, RenderUppercase: true, VerticalAlignment: Center);
          Text: %server.lowtalk.bindprop.name;
        }

        $C.@TextField #Name {
          @Anchor = (Width: 460);
          PlaceholderText: %server.lowtalk.bindprop.namePlaceholder;
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 8);

        Label {
          Anchor: (Width: 130);
          Style: (FontSize: 12, TextColor: #96a9be, RenderUppercase: true, VerticalAlignment: Center);
          Text: %server.lowtalk.bindprop.hint;
        }

        DropdownBox #Hint {
          Anchor: (Width: 460, Height: $C.@DropdownBoxHeight);
          Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 460);
        }
      }

      Label #Help {
        Anchor: (Top: 4);
        Style: (FontSize: 12, TextColor: #8fa3b8, Wrap: true);
        Text: %server.lowtalk.bindprop.help;
      }

      Group {
        LayoutMode: Right;
        Anchor: (Top: 14, Height: 34);

        $C.@TextButton #BindButton {
          @Anchor = (Width: 100, Right: 6);
          @Text = %server.lowtalk.bindprop.bind;
        }

        $C.@SecondaryTextButton #UnbindButton {
          @Anchor = (Width: 100, Right: 6);
          @Text = %server.lowtalk.bindprop.unbind;
        }

        $C.@SecondaryTextButton #EditButton {
          @Anchor = (Width: 100, Right: 6);
          @Text = %server.lowtalk.browse.edit;
        }

        $C.@SecondaryTextButton #NewButton {
          @Anchor = (Width: 130, Right: 6);
          @Text = %server.lowtalk.browse.new;
        }

        $C.@SecondaryTextButton #CancelButton {
          @Anchor = (Width: 100);
          @Text = %server.lowtalk.editor.close;
        }
      }
    }
  }
}
