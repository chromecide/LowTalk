$C = "../../Common.ui";

// One branch of an if-block: if / else if / else, its condition, and a button into its body.
Group {
  LayoutMode: Left;
  Anchor: (Height: 38, Bottom: 6);

  // A "!" here means the validator found an error on this row, a "?" a warning; empty when the row is fine.
  Label #Bad {
    Anchor: (Width: 16);
    Style: (FontSize: 15, TextColor: #ff9d8a, VerticalAlignment: Center, HorizontalAlignment: Center);
    Text: "";
  }

  Label #Tag {
    Anchor: (Width: 90);
    Style: (FontSize: 12, TextColor: #ffb86b, RenderUppercase: true, VerticalAlignment: Center);
    Text: "";
  }

  DropdownBox #Kind {
    Anchor: (Width: 240, Right: 8, Height: $C.@DropdownBoxHeight);
    Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 360);
    ShowSearchInput: true;
  }

  Group #Arg {
    FlexWeight: 3;
    LayoutMode: Left;

    $C.@TextField #V {
      @Anchor = (Right: 8);
      FlexWeight: 1;
    }

    // Width rather than FlexWeight: as the only visible child of the group this stretched to the whole row,
    // and a dropdown far wider than its own PanelWidth never opened its panel at all.
    DropdownBox #C {
      Anchor: (Width: 300, Right: 8, Height: $C.@DropdownBoxHeight);
      Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 300);
      ShowSearchInput: true;
    }

    $C.@SecondaryTextButton #B {
      @Anchor = (Left: 0, Right: 8);
      @Text = "";
      FlexWeight: 1;
    }
  }

  DropdownBox #Op {
    Anchor: (Width: 140, Right: 8, Height: $C.@DropdownBoxHeight);
    Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 220);
  }

  Group #Val {
    FlexWeight: 3;
    LayoutMode: Left;

    $C.@TextField #VV {
      @Anchor = (Right: 8);
      FlexWeight: 1;
    }

    DropdownBox #VC {
      Anchor: (Width: 300, Right: 8, Height: $C.@DropdownBoxHeight);
      Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 300);
      ShowSearchInput: true;
    }

    $C.@SecondaryTextButton #VB {
      @Anchor = (Left: 0, Right: 8);
      @Text = "";
      FlexWeight: 1;
    }
  }

  $C.@TextField #Raw {
    @Anchor = (Right: 8);
    FlexWeight: 6;
    PlaceholderText: %server.lowtalk.editor.conditionHint;
  }

  $C.@SecondaryTextButton #Body {
    @Anchor = (Width: 110, Right: 4);
    @Text = %server.lowtalk.editor.body;
  }

  $C.@SecondaryTextButton #AddBranch {
    @Anchor = (Width: 110, Right: 8);
    @Text = %server.lowtalk.editor.addBranch;
  }

  $C.@SecondaryTextButton #Up {
    @Anchor = (Width: 34, Right: 4);
    @Text = "^";
  }

  $C.@SecondaryTextButton #Down {
    @Anchor = (Width: 34, Right: 4);
    @Text = "v";
  }

  $C.@SecondaryTextButton #Del {
    @Anchor = (Width: 34);
    @Text = "x";
  }
}
