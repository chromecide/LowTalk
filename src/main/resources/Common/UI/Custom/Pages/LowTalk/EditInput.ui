$C = "../../Common.ui";

// <<input $var "prompt">>
Group {
  LayoutMode: Left;
  Anchor: (Height: 38, Bottom: 6);

  // A "!" here means the validator found an error on this row, a "?" a warning; empty when the row is fine.
  Label #Bad {
    Anchor: (Width: 16);
    Style: (FontSize: 15, TextColor: #ff9d8a, VerticalAlignment: Center, HorizontalAlignment: Center);
    Text: "";
  }

  Label #Tag {
    Anchor: (Width: 90);
    Style: (FontSize: 12, TextColor: #8fd0ff, RenderUppercase: true, VerticalAlignment: Center);
    Text: %server.lowtalk.editor.askInto;
  }

  $C.@TextField #Var {
    @Anchor = (Width: 200, Right: 6);
    PlaceholderText: "$variable";
  }

  $C.@TextField #Prompt {
    @Anchor = (Right: 8);
    FlexWeight: 1;
    PlaceholderText: %server.lowtalk.editor.promptHint;
  }

  // Text or number. A number box comes back until the player types one, rather than storing a word that
  // ends the conversation in whichever later line first treats the answer as a number.
  DropdownBox #Kind {
    Anchor: (Width: 120, Right: 8, Height: $C.@DropdownBoxHeight);
    Style: DropdownBoxStyle(...$C.@DefaultDropdownBoxStyle, PanelWidth: 160);
  }

  $C.@SecondaryTextButton #Up {
    @Anchor = (Width: 34, Right: 4);
    @Text = "^";
  }

  $C.@SecondaryTextButton #Down {
    @Anchor = (Width: 34, Right: 4);
    @Text = "v";
  }

  $C.@SecondaryTextButton #Del {
    @Anchor = (Width: 34);
    @Text = "x";
  }
}
