$C = "../../Common.ui";

// The details of the option above it: when it is offered, when it is greyed out, once, and its own body.
Group {
  LayoutMode: Left;
  Anchor: (Height: 38, Bottom: 8);

  Label #Pad {
    Anchor: (Width: 26);
  }

  Label #IfLabel {
    Anchor: (Width: 64);
    Style: (FontSize: 12, TextColor: #96a9be, RenderUppercase: true, VerticalAlignment: Center);
    Text: %server.lowtalk.editor.onlyIf;
  }

  $C.@TextField #If {
    @Anchor = (Right: 8);
    FlexWeight: 1;
    PlaceholderText: %server.lowtalk.editor.conditionHint;
  }

  Label #ShowLabel {
    Anchor: (Width: 90);
    Style: (FontSize: 12, TextColor: #96a9be, RenderUppercase: true, VerticalAlignment: Center);
    Text: %server.lowtalk.editor.greyUnless;
  }

  $C.@TextField #ShowIf {
    @Anchor = (Right: 8);
    FlexWeight: 1;
    PlaceholderText: %server.lowtalk.editor.conditionHint;
  }

  $C.@SecondaryTextButton #Once {
    @Anchor = (Width: 90, Right: 8);
    @Text = "";
  }

  $C.@SecondaryTextButton #Body {
    @Anchor = (Width: 150);
    @Text = %server.lowtalk.editor.optionBody;
  }
}
