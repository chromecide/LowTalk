$C = "../../Common.ui";

// What an option adds beyond its two conditions, which are rows of their own above this one: whether it can be
// picked more than once, and a way into the statements it runs.
Group {
  LayoutMode: Left;
  Anchor: (Height: 38, Bottom: 8);

  Label #Pad {
    Anchor: (Width: 26);
  }

  Label #Tag {
    Anchor: (Width: 90);
    Style: (FontSize: 12, TextColor: #96a9be, RenderUppercase: true, VerticalAlignment: Center);
    Text: %server.lowtalk.editor.optionExtras;
  }

  $C.@SecondaryTextButton #Once {
    @Anchor = (Width: 150, Right: 8);
    @Text = "";
  }

  $C.@SecondaryTextButton #Body {
    @Anchor = (Width: 200, Right: 8);
    @Text = %server.lowtalk.editor.optionBody;
  }

  Label #Fill {
    FlexWeight: 1;
  }
}
