{
  "$NodeId": "Dialogue-f4b7603f-953c-4d52-ad83-b5f29e0a4e31",
  "Npc": [
    "Kweebec_Elder"
  ],
  "Speaker": "Elder",
  "Title": "The Lore Keeper",
  "Scope": "",
  "Portrait": "",
  "On": "",
  "Start": [
    {
      "$NodeId": "Start-9c596df0-3963-4c45-ab6a-af7fd71e978c",
      "Passage": "start",
      "When": ""
    }
  ],
  "Passages": [
    {
      "$NodeId": "Passage-6a9b9f5e-49dc-43f7-bd30-48bc2585a8d5",
      "Name": "start",
      "Body": [
        {
          "$NodeId": "Say-502c4b23-5de2-46f8-b493-74ef284b98c0",
          "Type": "Say",
          "Speaker": "",
          "Text": "Sit a while, {player}. My roots are old and my memory is long. What would you hear of?"
        },
        {
          "$NodeId": "Choice-e439029b-8f5e-4c4f-9949-4b317d834352",
          "Type": "Choice",
          "Options": [
            {
              "$NodeId": "Option-2cc65863-0f17-45cd-87eb-5a1e4bb0edaf",
              "Text": "Tell me about the village.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-219b09e3-0d6e-4ad4-87c8-a6f02faf849c",
                  "Type": "Jump",
                  "Passage": "village"
                }
              ]
            },
            {
              "$NodeId": "Option-76f51ecf-c55d-40a9-91e0-2fc795b4d365",
              "Text": "What are the ruins to the north?",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-3d30edb4-b308-4b41-85d5-715b6f25ff94",
                  "Type": "Jump",
                  "Passage": "ruins"
                }
              ]
            },
            {
              "$NodeId": "Option-d657d9e3-9eed-4033-bc5a-e838212191cd",
              "Text": "Who fought the old war?",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-4825f20c-9169-4b81-a147-e8852f0b3d81",
                  "Type": "Jump",
                  "Passage": "war"
                }
              ]
            },
            {
              "$NodeId": "Option-87c8848b-69bd-428e-af3e-064fa3a92b73",
              "Text": "What should I do now?",
              "If": "",
              "ShowIf": "visited(\"village\") and visited(\"ruins\") and visited(\"war\")",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-38198d0a-ea0b-4bcc-9b85-2a54b5dd7342",
                  "Type": "Jump",
                  "Passage": "counsel"
                }
              ]
            },
            {
              "$NodeId": "Option-664c0204-33f1-446c-9dff-369dfbc67e79",
              "Text": "That is enough for today.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-ff657641-1c79-4908-8a2e-179967009e79",
                  "Type": "Jump",
                  "Passage": "farewell"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$NodeId": "Passage-ca6d19c1-00a2-459a-a185-956ea6385aa3",
      "Name": "village",
      "Body": [
        {
          "$NodeId": "Say-13e5c625-7ad8-4a33-9cfe-299ada74129b",
          "Type": "Say",
          "Speaker": "",
          "Text": "The Kweebec raised these terraces when the river still ran high. Every stone was carried by hand."
        },
        {
          "$NodeId": "Say-5dd953b3-0928-40d4-8530-83b1cc86d6bf",
          "Type": "Say",
          "Speaker": "",
          "Text": "We farm what the slopes allow and trade the rest. The merchant by the well will tell you the prices."
        },
        {
          "$NodeId": "Jump-a76c168d-6eb5-4143-be43-9b02db8d81ce",
          "Type": "Jump",
          "Passage": "start"
        }
      ]
    },
    {
      "$NodeId": "Passage-579fa56d-ab86-4303-8183-27104d8f69ec",
      "Name": "ruins",
      "Body": [
        {
          "$NodeId": "Say-2285043f-7070-483a-aa70-147fbb408601",
          "Type": "Say",
          "Speaker": "",
          "Text": "Older than us. Older than the Trork, whatever they claim."
        },
        {
          "$NodeId": "Say-fcd6cd31-e2ca-4d97-9433-7ea85d835890",
          "Type": "Say",
          "Speaker": "",
          "Text": "The walls hum at night. Nobody who went looking for the reason came back to explain it."
        },
        {
          "$NodeId": "Jump-a5db9593-8cb4-46df-aa3c-2d15b0974b03",
          "Type": "Jump",
          "Passage": "start"
        }
      ]
    },
    {
      "$NodeId": "Passage-2b00eb41-d45e-48e5-aaab-e9ff32faffbc",
      "Name": "war",
      "Body": [
        {
          "$NodeId": "Say-2bf50f19-2669-4d3b-821c-0ee0c37fe262",
          "Type": "Say",
          "Speaker": "",
          "Text": "The Trork came down the pass in numbers we had never seen. We held the bridge for nine days.",
          "Button": "And then?"
        },
        {
          "$NodeId": "Say-cbf5381d-5faa-4bcf-a38b-7860107d249e",
          "Type": "Say",
          "Speaker": "",
          "Text": "On the tenth the river rose and took the bridge, and them with it. Some say the grove asked it to."
        },
        {
          "$NodeId": "Jump-a020a3c8-566e-4c06-8ec7-f483c1aa955c",
          "Type": "Jump",
          "Passage": "start"
        }
      ]
    },
    {
      "$NodeId": "Passage-0cf1441c-7e50-40f6-a936-097c95e9b1d0",
      "Name": "counsel",
      "Body": [
        {
          "$NodeId": "Say-5b1ffc3e-1192-415a-9476-9e200f57f7ab",
          "Type": "Say",
          "Speaker": "",
          "Text": "You have heard the three tales, so you know what matters here: the river, the ruins, and the pass."
        },
        {
          "$NodeId": "Say-b6410664-5302-4e59-9b0c-329f35c576b0",
          "Type": "Say",
          "Speaker": "",
          "Text": "Keep to the terraces by day. If the walls hum, walk away. And if the Trork come again, find me first."
        },
        {
          "$NodeId": "Jump-42cab33a-de97-40ff-a2dd-afb9bde403ac",
          "Type": "Jump",
          "Passage": "start"
        }
      ]
    },
    {
      "$NodeId": "Passage-f1f6dc8c-4e3b-4f1c-9d9f-98cb9bb949d6",
      "Name": "farewell",
      "Body": [
        {
          "$NodeId": "Say-85e787e3-f199-4fb2-a28a-2dec9d1dd9b5",
          "Type": "Say",
          "Speaker": "",
          "Text": "Go well, {player}. The roots remember those who listen."
        },
        {
          "$NodeId": "End-41663bf3-bc3e-4bcf-b5fd-8876247b8ec3",
          "Type": "End"
        }
      ]
    }
  ],
