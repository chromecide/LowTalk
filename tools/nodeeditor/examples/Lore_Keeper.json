{
  "$NodeId": "Dialogue-eb69e1bb-a31f-472f-a976-9acb590ebc2f",
  "Npc": [
    "Kweebec_Elder"
  ],
  "Speaker": "Elder",
  "Title": "The Lore Keeper",
  "Scope": "",
  "Portrait": "",
  "On": "",
  "Start": [
    {
      "$NodeId": "Start-864e2cdb-8e1a-4611-9f7e-cea545618960",
      "Passage": "start",
      "When": ""
    }
  ],
  "Passages": [
    {
      "$NodeId": "Passage-f3cad49b-ef95-4119-8abc-105cc90564b4",
      "Name": "start",
      "Body": [
        {
          "$NodeId": "Say-8bb4545d-1f4c-4b31-b37f-e72ebe84fc4a",
          "Type": "Say",
          "Speaker": "",
          "Text": "Sit a while, {player}. My roots are old and my memory is long. What would you hear of?"
        },
        {
          "$NodeId": "Choice-89920bd4-a714-4e12-88b8-6ce4b1015533",
          "Type": "Choice",
          "Options": [
            {
              "$NodeId": "Option-8015adc7-a47e-4c8e-bb35-312118fbdfc8",
              "Text": "Tell me about the village.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-788d59d5-d6fd-4ce4-aadf-46af37c3d841",
                  "Type": "Jump",
                  "Passage": "village"
                }
              ]
            },
            {
              "$NodeId": "Option-a783b686-9a54-4f32-bfe0-dcfdee8290ff",
              "Text": "What are the ruins to the north?",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-c2d8c5bc-61ed-4328-bc53-215f47379c2e",
                  "Type": "Jump",
                  "Passage": "ruins"
                }
              ]
            },
            {
              "$NodeId": "Option-211a005c-9fd2-4602-bcae-f88449bafc45",
              "Text": "Who fought the old war?",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-036a8fab-271f-40d9-a442-8630d9c549d7",
                  "Type": "Jump",
                  "Passage": "war"
                }
              ]
            },
            {
              "$NodeId": "Option-132c9dc2-6400-4bb3-bc39-1afa1b0c570a",
              "Text": "What should I do now?",
              "If": "",
              "ShowIf": "visited(\"village\") and visited(\"ruins\") and visited(\"war\")",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-827bb7e7-3df4-4ce9-8a76-7b918053b739",
                  "Type": "Jump",
                  "Passage": "counsel"
                }
              ]
            },
            {
              "$NodeId": "Option-dbd9752a-5e97-47d4-b19c-b9906e9c39ff",
              "Text": "That is enough for today.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-3e728517-25da-44bf-8ff3-ee280de9919e",
                  "Type": "Jump",
                  "Passage": "farewell"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$NodeId": "Passage-15cb291f-b6d7-4b9b-8203-3edf4f37aa22",
      "Name": "village",
      "Body": [
        {
          "$NodeId": "Say-61ed16f2-1e33-4a86-9cc4-8a40c7d95b32",
          "Type": "Say",
          "Speaker": "",
          "Text": "The Kweebec raised these terraces when the river still ran high. Every stone was carried by hand."
        },
        {
          "$NodeId": "Say-80eea73c-dc6d-4349-8990-07f6e7f72a1c",
          "Type": "Say",
          "Speaker": "",
          "Text": "We farm what the slopes allow and trade the rest. The merchant by the well will tell you the prices."
        },
        {
          "$NodeId": "Jump-38a54c91-6ecd-4e73-b9ed-447431599eab",
          "Type": "Jump",
          "Passage": "start"
        }
      ]
    },
    {
      "$NodeId": "Passage-e6405bd3-4c39-4afa-a7d7-265d67c6b780",
      "Name": "ruins",
      "Body": [
        {
          "$NodeId": "Say-2ceb79fc-5a24-4bab-90ae-88828ca91d3a",
          "Type": "Say",
          "Speaker": "",
          "Text": "Older than us. Older than the Trork, whatever they claim."
        },
        {
          "$NodeId": "Say-5cf77f91-1d94-4986-9d3e-65f8aa3de2dc",
          "Type": "Say",
          "Speaker": "",
          "Text": "The walls hum at night. Nobody who went looking for the reason came back to explain it."
        },
        {
          "$NodeId": "Jump-858f8116-ba0f-44b1-8382-267dda47adb0",
          "Type": "Jump",
          "Passage": "start"
        }
      ]
    },
    {
      "$NodeId": "Passage-4f03c260-b2ee-4d1d-a248-b2e39154f8fc",
      "Name": "war",
      "Body": [
        {
          "$NodeId": "Say-4ec1396c-8081-4a8c-89dd-ab57bdfefcc3",
          "Type": "Say",
          "Speaker": "",
          "Text": "The Trork came down the pass in numbers we had never seen. We held the bridge for nine days.",
          "Button": "And then?"
        },
        {
          "$NodeId": "Say-7b1a08c7-59b5-4ef8-aa6c-c3ed8424431a",
          "Type": "Say",
          "Speaker": "",
          "Text": "On the tenth the river rose and took the bridge, and them with it. Some say the grove asked it to."
        },
        {
          "$NodeId": "Jump-e15866b5-4e87-4e31-9ad6-3016b2a9d2cd",
          "Type": "Jump",
          "Passage": "start"
        }
      ]
    },
    {
      "$NodeId": "Passage-21316a3b-a9bd-4122-a1cd-b722c387828b",
      "Name": "counsel",
      "Body": [
        {
          "$NodeId": "Say-f061ce50-4877-4e2b-b877-9269fdfbc91e",
          "Type": "Say",
          "Speaker": "",
          "Text": "You have heard the three tales, so you know what matters here: the river, the ruins, and the pass."
        },
        {
          "$NodeId": "Say-0701ead8-bd02-4bc5-b113-08c4c9dd3c4a",
          "Type": "Say",
          "Speaker": "",
          "Text": "Keep to the terraces by day. If the walls hum, walk away. And if the Trork come again, find me first."
        },
        {
          "$NodeId": "Jump-3b5d2aba-916f-460a-befc-9e6f3773845b",
          "Type": "Jump",
          "Passage": "start"
        }
      ]
    },
    {
      "$NodeId": "Passage-02ab19ee-daa0-4d87-8514-db8f9488db50",
      "Name": "farewell",
      "Body": [
        {
          "$NodeId": "Say-41bb0e41-f8e4-47bf-87bd-86b0afd31dcb",
          "Type": "Say",
          "Speaker": "",
          "Text": "Go well, {player}. The roots remember those who listen."
        },
        {
          "$NodeId": "End-05e89f89-a3d5-49e8-ba55-d03d8cbf6784",
          "Type": "End"
        }
      ]
    }
  ],
