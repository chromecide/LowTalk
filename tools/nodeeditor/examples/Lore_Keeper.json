{
  "$NodeId": "Dialogue-27f1a218-6c9b-40b1-b111-94cb9e04ae14",
  "Npc": [
    "Kweebec_Elder"
  ],
  "Speaker": "Elder",
  "Title": "The Lore Keeper",
  "Scope": "",
  "Portrait": "",
  "On": "",
  "Start": [
    {
      "$NodeId": "Start-1ceb16d3-6d5f-4979-81cd-57ae1db605ae",
      "Node": "start",
      "When": ""
    }
  ],
  "Nodes": [
    {
      "$NodeId": "Node-0c417ec8-1d8c-4fa4-8dd1-5576e3492a83",
      "Name": "start",
      "Body": [
        {
          "$NodeId": "Say-4ce426b6-fede-460b-81df-ed5f297e4ffc",
          "Type": "Say",
          "Speaker": "",
          "Text": "Sit a while, {player}. My roots are old and my memory is long. What would you hear of?"
        },
        {
          "$NodeId": "Choice-fcd34577-355d-47c1-9752-59943632559a",
          "Type": "Choice",
          "Options": [
            {
              "$NodeId": "Option-c8413b31-539f-4f1e-ae51-b1bab4438ad5",
              "Text": "Tell me about the village.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-515b629f-0e96-4c77-8c3b-a7fba27afe29",
                  "Type": "Jump",
                  "Node": "village"
                }
              ]
            },
            {
              "$NodeId": "Option-3ab6c29d-54ad-4643-9e58-2a4b3db7c6b0",
              "Text": "What are the ruins to the north?",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-4b9a92ec-ac68-4d31-855a-27e8e2891c66",
                  "Type": "Jump",
                  "Node": "ruins"
                }
              ]
            },
            {
              "$NodeId": "Option-3421f4bc-df00-42fc-88eb-34404cee7c05",
              "Text": "Who fought the old war?",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-6148787d-546b-456e-be28-79d2c85a2dc7",
                  "Type": "Jump",
                  "Node": "war"
                }
              ]
            },
            {
              "$NodeId": "Option-0cf173aa-fef8-4d08-bdb7-1ea26e9607ab",
              "Text": "What should I do now?",
              "If": "",
              "ShowIf": "visited(\"village\") and visited(\"ruins\") and visited(\"war\")",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-a4cdb8ba-9b10-400a-b638-f62289850547",
                  "Type": "Jump",
                  "Node": "counsel"
                }
              ]
            },
            {
              "$NodeId": "Option-c48360f5-1df7-4d6a-9990-d5886159ce6c",
              "Text": "That is enough for today.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Jump-15477936-bf19-4b2f-a861-04ee1c4aecab",
                  "Type": "Jump",
                  "Node": "farewell"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$NodeId": "Node-da98130c-dfcd-4952-b2ef-60160d9fdbab",
      "Name": "village",
      "Body": [
        {
          "$NodeId": "Say-d550e0c5-7800-48cb-bcac-134bbc59ae53",
          "Type": "Say",
          "Speaker": "",
          "Text": "The Kweebec raised these terraces when the river still ran high. Every stone was carried by hand."
        },
        {
          "$NodeId": "Say-fef76709-61cb-49fc-8819-92c41ce4d127",
          "Type": "Say",
          "Speaker": "",
          "Text": "We farm what the slopes allow and trade the rest. The merchant by the well will tell you the prices."
        },
        {
          "$NodeId": "Jump-e60cbb87-9cb0-47cb-812e-5b4641ecb4db",
          "Type": "Jump",
          "Node": "start"
        }
      ]
    },
    {
      "$NodeId": "Node-5eb0855d-c498-48b7-9766-ebf570d6d34f",
      "Name": "ruins",
      "Body": [
        {
          "$NodeId": "Say-402cedc2-2bbd-4015-a239-aeaaef0fd39a",
          "Type": "Say",
          "Speaker": "",
          "Text": "Older than us. Older than the Trork, whatever they claim."
        },
        {
          "$NodeId": "Say-99a0836c-e7ff-4fea-b55f-8e8a840aa2e4",
          "Type": "Say",
          "Speaker": "",
          "Text": "The walls hum at night. Nobody who went looking for the reason came back to explain it."
        },
        {
          "$NodeId": "Jump-0949b4a8-37b0-4636-afc6-38280672906d",
          "Type": "Jump",
          "Node": "start"
        }
      ]
    },
    {
      "$NodeId": "Node-0c326fd4-cbc9-4bd2-b597-0b3b96b5b33d",
      "Name": "war",
      "Body": [
        {
          "$NodeId": "Say-9e865b5a-b3ce-4d45-8a2b-a02efeec349c",
          "Type": "Say",
          "Speaker": "",
          "Text": "The Trork came down the pass in numbers we had never seen. We held the bridge for nine days.",
          "Button": "And then?"
        },
        {
          "$NodeId": "Say-dac78d29-03ca-4d9e-97df-0d3e1b0fa813",
          "Type": "Say",
          "Speaker": "",
          "Text": "On the tenth the river rose and took the bridge, and them with it. Some say the grove asked it to."
        },
        {
          "$NodeId": "Jump-047a8e09-4816-4d01-b0fa-4f3f51f0b3ed",
          "Type": "Jump",
          "Node": "start"
        }
      ]
    },
    {
      "$NodeId": "Node-064644a3-daa1-4bfb-af80-46a09240362b",
      "Name": "counsel",
      "Body": [
        {
          "$NodeId": "Say-6d8e2bcc-c6b6-4354-b4b3-4e737e546b5a",
          "Type": "Say",
          "Speaker": "",
          "Text": "You have heard the three tales, so you know what matters here: the river, the ruins, and the pass."
        },
        {
          "$NodeId": "Say-d6d2de51-d7b5-4a4f-a3e5-3599371c1a7e",
          "Type": "Say",
          "Speaker": "",
          "Text": "Keep to the terraces by day. If the walls hum, walk away. And if the Trork come again, find me first."
        },
        {
          "$NodeId": "Jump-5f0d167a-cb36-4b58-b293-0e9ef7c61559",
          "Type": "Jump",
          "Node": "start"
        }
      ]
    },
    {
      "$NodeId": "Node-28aaf236-b535-435b-b3f1-7aec761ff3fb",
      "Name": "farewell",
      "Body": [
        {
          "$NodeId": "Say-b43853db-d66b-445c-b909-4bdbe4cd3d82",
          "Type": "Say",
          "Speaker": "",
          "Text": "Go well, {player}. The roots remember those who listen."
        },
        {
          "$NodeId": "End-4b3c0693-76c0-4808-878a-cc02700dd6d8",
          "Type": "End"
        }
      ]
    }
  ],
