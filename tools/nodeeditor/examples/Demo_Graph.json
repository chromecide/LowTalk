  "On": "",
  "Start": [
    {
      "$NodeId": "Start-4f97ae2a-add6-4d1e-9995-52337936ff94",
      "Passage": "returning",
      "When": "$met"
    },
    {
      "$NodeId": "Start-1c4c6d1f-06fc-4200-ae08-62ff3d8a372c",
      "Passage": "start",
      "When": ""
    }
  ],
  "Passages": [
    {
      "$NodeId": "Passage-95478ac1-14bd-4ccb-b48c-216606326fbc",
      "Name": "start",
      "Body": [
        {
          "$NodeId": "Say-64546bc4-9bb3-4a23-ba4e-408623bbaa1f",
          "Type": "Say",
          "Speaker": "",
          "Text": "[Well met|Good day], {player}. Welcome to the valley."
        },
        {
          "$NodeId": "Set-d0677261-c64b-44fe-af94-7e6bb2acbb54",
          "Type": "Set",
          "Var": "$met",
          "Value": "true"
        },
        {
          "$NodeId": "Choice-9f039945-5332-49be-80e2-3b655d25c80e",
          "Type": "Choice",
          "Options": [
            {
              "$NodeId": "Option-8281a3f1-c317-4053-8dc3-f59975d4df88",
              "Text": "Tell me about this place.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Say-c2b1b589-1503-42c9-b546-4b963072cf1b",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "The Rootlings farm the terraces; the ruins to the north are best left alone."
                },
                {
                  "$NodeId": "Jump-7796cd2c-6593-42a3-9ea1-de8a960bfec6",
                  "Type": "Jump",
                  "Passage": "start"
                }
              ]
            },
            {
              "$NodeId": "Option-f9f0d76f-8f7f-4090-85a7-c5245df51945",
              "Text": "Any work for me?",
              "If": "not $player.errand",
              "ShowIf": "",
              "Once": true,
              "Body": [
                {
                  "$NodeId": "Say-68564e43-4e9c-4f96-8f12-f46086c47c13",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Take this bread to the miller. Tell him the guide sent you."
                },
                {
                  "$NodeId": "Give-f7981ed6-441c-4dbc-bb15-72fcb8bfed75",
                  "Type": "Give",
                  "Item": "Food_Bread",
                  "Count": 1
                },
                {
                  "$NodeId": "Set-35164b3d-a15d-43c7-9af7-5114bf02a4ad",
                  "Type": "Set",
                  "Var": "$player.errand",
                  "Value": "true"
                },
                {
                  "$NodeId": "Notify-15a0f40c-9e9c-4000-b68e-873821a5b5de",
                  "Type": "Notify",
                  "Text": "New errand: bread for the miller",
                  "Detail": "",
                  "Style": "success"
                },
                {
                  "$NodeId": "Jump-088a048a-ac5c-4fbd-84ec-ab3091f719e4",
                  "Type": "Jump",
                  "Passage": "start"
                }
              ]
            },
            {
              "$NodeId": "Option-8f63f353-0f09-4c32-a342-68b606aec935",
              "Text": "Goodbye.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Say-e5d453c6-4dca-42be-9411-ceb981f5a151",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Safe travels."
                },
                {
                  "$NodeId": "End-4acccfdc-0ba6-4ec3-b170-ef11c7bb3efe",
                  "Type": "End"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$NodeId": "Passage-57e3c87a-ef1e-4964-b0a7-bffcf19b62cb",
      "Name": "returning",
      "Body": [
        {
          "$NodeId": "Say-7796b28c-6911-4631-a638-60d5f608011c",
          "Type": "Say",
          "Speaker": "",
          "Text": "[Back again|Hello again], {player}."
        },
        {
          "$NodeId": "If-c7702834-b1a1-4936-98e7-07329c644f6e",
          "Type": "If",
          "Branches": [
            {
              "$NodeId": "Branch-ea5a604b-835d-42e3-8675-05fd6fba9e4a",
              "When": "$player.errand",
              "Body": [
                {
                  "$NodeId": "Say-51025f95-4f75-406a-a001-d7d683157cb0",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "How is the errand going? The miller is waiting."
                }
              ]
            },
            {
              "$NodeId": "Branch-6bc57005-1cf2-4c45-8d32-517b465ac9d8",
              "When": "",
              "Body": [
                {
                  "$NodeId": "Say-615345b5-278c-4c6f-8f2c-53a62b21f4d9",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Still looking for work? Ask me."
                }
              ]
            }
          ]
        },
        {
          "$NodeId": "Jump-fd8ca93d-ced2-440c-9c61-83be34a55e76",
          "Type": "Jump",
          "Passage": "start"
        }
      ]
    }
  ],
