  "On": "",
  "Start": [
    {
      "$NodeId": "Start-d185111a-c734-4e47-a79a-169b100296ec",
      "Node": "returning",
      "When": "$met"
    },
    {
      "$NodeId": "Start-0b2ca791-3b0e-42a4-8f41-02b5d1b74046",
      "Node": "start",
