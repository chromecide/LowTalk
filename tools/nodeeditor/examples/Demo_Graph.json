{
  "$NodeId": "Dialogue-9744682f-78e9-4383-a7c3-98001fdd060a",
  "Npc": [
    "@guide"
  ],
  "Speaker": "Guide",
  "Title": "The Valley Guide",
  "Scope": "",
  "Portrait": "",
  "On": "",
  "Start": [
    {
      "$NodeId": "Start-fcd71215-5a39-4c59-acbf-de92860aa313",
      "Node": "returning",
      "When": "$met"
    },
    {
      "$NodeId": "Start-6351efcc-0728-4d6e-b9dc-18392000366d",
      "Node": "start",
      "When": ""
    }
  ],
  "Nodes": [
    {
      "$NodeId": "Node-fe41beaf-a5ee-41a3-a207-67e38d3c6c2e",
      "Name": "start",
      "Body": [
        {
          "$NodeId": "Say-f34974bf-2cb0-4799-b128-98cdf7e8fcd9",
          "Type": "Say",
          "Speaker": "",
          "Text": "[Well met|Good day], {player}. Welcome to the valley."
        },
        {
          "$NodeId": "Set-658cb19e-a7d5-4e67-8ec5-64550267dc1b",
          "Type": "Set",
          "Var": "$met",
          "Value": "true"
        },
        {
          "$NodeId": "Choice-d123ef7a-50a0-4242-96eb-4ebcb4d0373e",
          "Type": "Choice",
          "Options": [
            {
              "$NodeId": "Option-17935da4-8909-4f80-b50f-5d752997609d",
              "Text": "Tell me about this place.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Say-17231f9f-214e-45c3-a265-092aa94ddb41",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "The Rootlings farm the terraces; the ruins to the north are best left alone."
                },
                {
                  "$NodeId": "Jump-82ddc384-7512-47e5-8571-057deb89d664",
                  "Type": "Jump",
                  "Node": "start"
                }
              ]
            },
            {
              "$NodeId": "Option-3b4fe228-40a9-4091-8a5c-d47c921dc1c0",
              "Text": "Any work for me?",
              "If": "not $player.errand",
              "ShowIf": "",
              "Once": true,
              "Body": [
                {
                  "$NodeId": "Say-5ad8dc1a-01a9-4604-a127-9daf8cc5937a",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Take this bread to the miller. Tell him the guide sent you."
                },
                {
                  "$NodeId": "Give-76376e9a-bde9-4ffd-9875-0caa580950e7",
                  "Type": "Give",
                  "Item": "Food_Bread",
                  "Count": 1
                },
                {
                  "$NodeId": "Set-a711f783-1d6d-4e84-b1e4-21935491052e",
                  "Type": "Set",
                  "Var": "$player.errand",
                  "Value": "true"
                },
                {
                  "$NodeId": "Notify-8cc3d8b4-e866-40b3-b876-97dfbd8b8963",
                  "Type": "Notify",
                  "Text": "New errand: bread for the miller",
                  "Detail": "",
                  "Style": "success"
                },
                {
                  "$NodeId": "Jump-f72f4021-bbfd-4efc-97ed-9344022a512d",
                  "Type": "Jump",
                  "Node": "start"
                }
              ]
            },
            {
              "$NodeId": "Option-7d635928-a891-4803-87e5-3362895b6cba",
              "Text": "Goodbye.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Say-877e5d84-1197-411b-acab-2bceb4b616fc",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Safe travels."
                },
                {
                  "$NodeId": "End-c87fb002-4038-4e23-b5ed-9e000ba74057",
                  "Type": "End"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$NodeId": "Node-21e57c22-f913-4aff-ac4e-a486c12639a4",
      "Name": "returning",
      "Body": [
        {
          "$NodeId": "Say-83c5d4c7-28e2-47b0-b911-f75b2d7539a7",
          "Type": "Say",
          "Speaker": "",
          "Text": "[Back again|Hello again], {player}."
        },
        {
          "$NodeId": "If-a494f3fc-eb31-4914-bfc9-210d63d3cd5f",
          "Type": "If",
          "Branches": [
            {
              "$NodeId": "Branch-78c5dbd7-9e92-4b62-975e-ed83ce2072bd",
              "When": "$player.errand",
              "Body": [
                {
                  "$NodeId": "Say-79ae26aa-79ff-4274-b1b1-daac8b1287b6",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "How is the errand going? The miller is waiting."
                }
              ]
            },
            {
              "$NodeId": "Branch-bc046369-f62b-48b8-9e0e-d9d1516fb4d0",
              "When": "",
              "Body": [
                {
                  "$NodeId": "Say-bacdff99-e676-4667-a449-ae9f8b937ed3",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Still looking for work? Ask me."
                }
              ]
            }
          ]
        },
        {
          "$NodeId": "Jump-9babf8d3-f1c8-483c-96dd-e4adea8b589f",
          "Type": "Jump",
          "Node": "start"
        }
      ]
    }
  ],
