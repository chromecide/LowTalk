  ],
  "Passages": [
    {
      "$NodeId": "Passage-5107a265-1683-4543-9c34-62023a4feac6",
      "Name": "start",
      "Body": [
        {
          "$NodeId": "Say-dd59384d-2a26-4e0c-95d5-a69da2ea01a1",
          "Type": "Say",
          "Speaker": "",
          "Text": "[Well met|Good day], {player}. Welcome to the valley."
        },
        {
          "$NodeId": "Set-b8ef75b2-74d3-4df7-a4f3-89fcc0b4083c",
          "Type": "Set",
          "Var": "$met",
          "Value": "true"
        },
        {
          "$NodeId": "Choice-dbe81f59-1a8f-4245-8549-41d8d20e2991",
          "Type": "Choice",
          "Options": [
            {
              "$NodeId": "Option-2c6df9c8-546d-47a2-8542-b60f47b02d03",
              "Text": "Tell me about this place.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Say-5ab7a5c3-3233-4594-9f04-c2251581f065",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "The Rootlings farm the terraces; the ruins to the north are best left alone."
                },
                {
                  "$NodeId": "Jump-54b4227f-b3ce-417d-a9b3-93e99a340631",
                  "Type": "Jump",
                  "Passage": "start"
                }
              ]
            },
            {
              "$NodeId": "Option-8bf343d0-2dfb-4ca2-b34e-00458201cbbb",
              "Text": "Any work for me?",
              "If": "not $player.errand",
              "ShowIf": "",
              "Once": true,
              "Body": [
                {
                  "$NodeId": "Say-68072c0c-3591-4f23-9b31-d2ca0aaf939a",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Take this bread to the miller. Tell him the guide sent you."
                },
                {
                  "$NodeId": "Give-b335772e-ba81-41ff-a95d-a634adec00ee",
                  "Type": "Give",
                  "Item": "Food_Bread",
                  "Count": 1
                },
                {
                  "$NodeId": "Set-835470ef-e53d-4808-9b82-da22f7996e76",
                  "Type": "Set",
                  "Var": "$player.errand",
                  "Value": "true"
                },
                {
                  "$NodeId": "Notify-dd2d6bf3-7810-43ec-9417-3aa10b0565e0",
                  "Type": "Notify",
                  "Text": "New errand: bread for the miller",
                  "Detail": "",
                  "Style": "success"
                },
                {
                  "$NodeId": "Jump-7b879a12-491e-461c-92d0-8efdb56d4339",
                  "Type": "Jump",
                  "Passage": "start"
                }
              ]
            },
            {
              "$NodeId": "Option-255c1538-56fc-4e32-a38f-8d31c2b0147a",
              "Text": "Goodbye.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Say-eb9054f6-05ba-46c5-a481-0a55e0181f85",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Safe travels."
                },
                {
                  "$NodeId": "End-ed6647fd-9d79-4c2d-87b5-02725d6f0530",
                  "Type": "End"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$NodeId": "Passage-69698428-b4d0-4c5d-9e9e-4b2788a679f7",
      "Name": "returning",
      "Body": [
        {
          "$NodeId": "Say-2e704541-d0a6-424a-b0d0-034ba968e708",
          "Type": "Say",
          "Speaker": "",
          "Text": "[Back again|Hello again], {player}."
        },
        {
          "$NodeId": "If-b09ca145-5302-46e6-912c-2b0e01515028",
          "Type": "If",
          "Branches": [
            {
              "$NodeId": "Branch-0f803992-ae17-4af6-b973-785f4405307d",
              "When": "$player.errand",
              "Body": [
                {
                  "$NodeId": "Say-a4f8af2f-9675-45e3-9122-13bd54780b3d",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "How is the errand going? The miller is waiting."
                }
              ]
            },
            {
              "$NodeId": "Branch-ce1230a0-52ee-4cb2-86d4-c54721f39f18",
              "When": "",
              "Body": [
                {
                  "$NodeId": "Say-89ff4621-2dcf-4d20-b839-66cddf45a2b3",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Still looking for work? Ask me."
                }
              ]
            }
          ]
        },
        {
          "$NodeId": "Jump-0fd5509c-4b4f-4096-bb91-4fffc770c574",
          "Type": "Jump",
          "Passage": "start"
        }
      ]
    }
  ],
