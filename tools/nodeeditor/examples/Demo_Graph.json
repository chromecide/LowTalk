  "Title": "The Valley Guide",
  "Scope": "",
  "Portrait": "",
  "On": "",
  "Start": [
    {
      "$NodeId": "Start-11706312-9273-40ee-8a42-0153300c2f89",
      "Node": "returning",
      "When": "$met"
    },
    {
      "$NodeId": "Start-07a0bbbb-0d76-4f4b-8ba2-76dbfe11b3de",
      "Node": "start",
      "When": ""
    }
  ],
  "Nodes": [
    {
      "$NodeId": "Node-a0af0105-de43-4f38-90dc-62e139a96de0",
      "Name": "start",
      "Body": [
        {
          "$NodeId": "Say-a8b1e900-171c-4d93-a3bd-bed34b241582",
          "Type": "Say",
          "Speaker": "",
          "Text": "[Well met|Good day], {player}. Welcome to the valley."
        },
        {
          "$NodeId": "Set-a73a00d2-e1f5-4dfe-bd0f-531a0ec38164",
          "Type": "Set",
          "Var": "$met",
          "Value": "true"
        },
        {
          "$NodeId": "Choice-5a58ae49-fe4e-4a50-b430-633b4a01d5ba",
          "Type": "Choice",
          "Options": [
            {
              "$NodeId": "Option-66a87695-9750-4521-b6aa-adb81950ba22",
              "Text": "Tell me about this place.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Say-5ce6e82c-9d01-4442-88e8-814506ebff12",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "The Rootlings farm the terraces; the ruins to the north are best left alone."
                },
                {
                  "$NodeId": "Jump-f8003ede-264c-4128-b610-ebd2be601361",
                  "Type": "Jump",
                  "Node": "start"
                }
              ]
            },
            {
              "$NodeId": "Option-55796790-0d75-4aba-a51b-ed21e3e10aef",
              "Text": "Any work for me?",
              "If": "not $player.errand",
              "ShowIf": "",
              "Once": true,
              "Body": [
                {
                  "$NodeId": "Say-96652a85-4f06-48b5-98db-526781c0bee1",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Take this bread to the miller. Tell him the guide sent you."
                },
                {
                  "$NodeId": "Give-3f33587b-872b-4b71-be54-b38f3ceb4cf5",
                  "Type": "Give",
                  "Item": "Food_Bread",
                  "Count": 1
                },
                {
                  "$NodeId": "Set-d5f58008-43e5-4e18-9130-2536f79266bd",
                  "Type": "Set",
                  "Var": "$player.errand",
                  "Value": "true"
                },
                {
                  "$NodeId": "Notify-d16faa3f-e6fa-44f2-8eb0-1261572fa32d",
                  "Type": "Notify",
                  "Text": "New errand: bread for the miller",
                  "Detail": "",
                  "Style": "success"
                },
                {
                  "$NodeId": "Jump-bfda5019-e705-4690-ad77-b411d0bba961",
                  "Type": "Jump",
                  "Node": "start"
                }
              ]
            },
            {
              "$NodeId": "Option-458a7148-dffd-43ba-932e-9e6a83f5c4a0",
              "Text": "Goodbye.",
              "If": "",
              "ShowIf": "",
              "Once": false,
              "Body": [
                {
                  "$NodeId": "Say-32477ee1-4e8b-4768-a146-4cd380ca794c",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Safe travels."
                },
                {
                  "$NodeId": "End-abbd8581-60a6-4bc3-b59a-b0dda6b33303",
                  "Type": "End"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$NodeId": "Node-3ad207dc-fa39-4760-a6bd-25d2077e296e",
      "Name": "returning",
      "Body": [
        {
          "$NodeId": "Say-65c1c7ae-1efc-48b9-bde1-b28e80cd4903",
          "Type": "Say",
          "Speaker": "",
          "Text": "[Back again|Hello again], {player}."
        },
        {
          "$NodeId": "If-2316c769-9cdd-484c-93eb-23dd3374500e",
          "Type": "If",
          "Branches": [
            {
              "$NodeId": "Branch-f010bd0c-d94c-4f37-9b47-8b60b04d5dc2",
              "When": "$player.errand",
              "Body": [
                {
                  "$NodeId": "Say-e4d08016-f79a-425f-9173-16d71ca60002",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "How is the errand going? The miller is waiting."
                }
              ]
            },
            {
              "$NodeId": "Branch-dab925e9-1a92-4818-8001-017a8a4bf9cd",
              "When": "",
              "Body": [
                {
                  "$NodeId": "Say-6a3a1ff9-a3f8-4329-91b2-c165ebcfc59e",
                  "Type": "Say",
                  "Speaker": "",
                  "Text": "Still looking for work? Ask me."
                }
              ]
            }
          ]
        },
        {
          "$NodeId": "Jump-cad71693-2c27-4c59-a6bd-74e71fece758",
          "Type": "Jump",
          "Node": "start"
        }
      ]
    }
  ],
